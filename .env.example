# Clerk publishable key (frontend auth)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Optional: Clerk Frontend API proxy URL (leave empty for default)
VITE_CLERK_PROXY_URL=

# Backend API URL used by the dev-server proxy for /api requests
VITE_API_URL=http://localhost:8080

# Set to "false" to test the real auth/paywall flow in dev
VITE_PREVIEW_MODE=
